# Adivasi Suraksha - server-side secrets (example).
#
# Copy to .env.local for `next dev` and fill in real values. In production these
# are set in the Cloudflare Pages project: Settings -> Environment variables.
# Never commit real secrets.

# Ambee air quality (~100 calls/day on an evaluation key).
AMBEE_KEY=

# NASA Earthdata Login bearer token for GES DISC / GPM IMERG.
# Requires a one-time GES DISC EULA approval on the account.
EARTHDATA_TOKEN=

# ReliefWeb API v2 approved appname (v1 is decommissioned).
RELIEFWEB_APPNAME=

# Optional: override the ISRO Bhuvan routing token that also ships (publicly)
# in config.js. It expires after one day.
BHUVAN_TOKEN=
